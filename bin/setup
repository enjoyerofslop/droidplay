#!/usr/bin/env bash
# Set up DroidPlay on this Mac; safe to run again. Checks the Mac and Xcode (downloading its Metal
# Toolchain, which the shader builds need, when missing), installs the tools
# (Homebrew, Brewfile; mise.toml too when mise is there), the Python packages (uv, into .venv), clones
# nxnative into ./nxnative and DroidPlay Core (its Android port) into ./droidplay-core, installs what Android builds need (a JDK and
# sdkmanager from Homebrew, Brewfile.android; the SDK's NDK, CMake, build-tools and platform-tools into ANDROID_HOME, else
# ~/Library/Android/sdk), then builds DroidPlay and installs it into /Applications.
#
# usage: bin/setup [--check] [--no-app]
#   --check   only report what is missing; change nothing
#   --no-app  skip building and installing DroidPlay
# DroidPlay runs this same script from its bundle (Settings › Setup), with:
#   NXPLAY_HOME     its own folder (~/Library/Application Support/DroidPlay): uv's Python and cache go there, and the
#                   developer parts (mise, building the app) are left out
#   NXPLAY_PROJECT  the folder with the Brewfile, pyproject.toml and uv.lock (default: this checkout)
#   NXPLAY_VENV     the Python environment (default: .venv in the project folder)
#   NXNATIVE        the nxnative checkout (default: ./nxnative, else ../nxnative)
#   SUDO_ASKPASS    a password prompt: the .NET SDK's installer and Xcode's first launch then run without a terminal
#   NXPLAY_ANDROID_LICENSES=accept  the player accepted the Android SDK License in DroidPlay: sdkmanager installs without asking
#   NXNATIVE_ANDROID  the DroidPlay Core checkout; ANDROID_HOME  the Android SDK (default ~/Library/Android/sdk)
set -euo pipefail
# the checkout keeps the Brewfile above bin/; the app's bundled copy (Resources/Setup) keeps it beside the script
here="$(cd "$(dirname "$0")" && pwd)"
if [[ -f "$here/Brewfile" ]]; then default_project="$here"; else default_project="$(dirname "$here")"; fi
project="${NXPLAY_PROJECT:-$default_project}"
cd "$project"
app_run=0
[[ -n "${NXPLAY_HOME:-}" ]] && app_run=1
# a GUI app doesn't get the shell's PATH: where Homebrew and the .NET SDK put their commands
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/local/share/dotnet:$PATH"
venv="${NXPLAY_VENV:-$project/.venv}"
export UV_PROJECT_ENVIRONMENT="$venv"
if (( app_run )); then
  # everything DroidPlay installs in one folder, Python included (not whichever Python the Mac happens to have)
  export UV_PYTHON_INSTALL_DIR="$NXPLAY_HOME/python" UV_CACHE_DIR="$NXPLAY_HOME/uv-cache" UV_PYTHON_PREFERENCE=only-managed
  app=0
fi
sudo_cmd=(sudo)
[[ -n "${SUDO_ASKPASS:-}" ]] && sudo_cmd=(sudo -A)

check=0 app=1
for arg in "$@"; do
  case "$arg" in
    --check) check=1 ;;
    --no-app) app=0 ;;
    *) echo "usage: bin/setup [--check] [--no-app]" >&2; exit 2 ;;
  esac
done

if [[ -t 1 ]]; then green=$'\e[32m' yellow=$'\e[33m' red=$'\e[31m' bold=$'\e[1m' reset=$'\e[0m'
else green="" yellow="" red="" bold="" reset=""; fi
failures=0
section() { printf '\n%s%s%s\n' "$bold" "$1" "$reset"; }
ok() { printf '  %s✓%s %s\n' "$green" "$reset" "$1"; }
warn() { printf '  %s!%s %s\n' "$yellow" "$reset" "$1"; }
fail() { printf '  %s✗%s %s\n' "$red" "$reset" "$1"; failures=$(( failures + 1 )); }
# step <done message> <failure message> <command...>: run it, report either way
step() {
  local done="$1" failed="$2"; shift 2
  if "$@"; then ok "$done"; else fail "$failed"; fi
}

section "Mac"
if [[ "$(uname -m)" == arm64 ]]; then ok "Apple silicon"
else warn "Intel Mac: games cannot run on this Mac (the Mac host needs Apple silicon); IPAs and device installs still work"; fi
macos="$(sw_vers -productVersion)"
if (( ${macos%%.*} >= 15 )); then ok "macOS $macos"
else fail "macOS $macos: DroidPlay needs macOS 15 or later"; fi

section "Xcode"
developer="$(xcode-select -p 2>/dev/null || true)"
if [[ "$developer" == *.app/Contents/Developer ]]; then
  ok "$(xcodebuild -version 2>/dev/null | head -1) ($developer)"
  if xcodebuild -checkFirstLaunchStatus > /dev/null 2>&1; then ok "first launch done (license, components)"
  elif (( !check )) && [[ -n "${SUDO_ASKPASS:-}" ]]; then
    step "first launch done (license, components)" "Xcode's first launch failed: sudo xcodebuild -runFirstLaunch" "${sudo_cmd[@]}" xcodebuild -runFirstLaunch
  else fail "Xcode needs its first launch (license, components): sudo xcodebuild -runFirstLaunch"; fi
  if xcodebuild -showsdks 2>/dev/null | grep -q iphoneos; then ok "iOS platform"
  else warn "no iOS platform: IPAs and Install on Device need it: xcodebuild -downloadPlatform iOS"; fi
  # every build compiles the game's shaders with it; from Xcode 26 on it is a separate download
  if xcrun metal --version > /dev/null 2>&1; then ok "Metal compiler ($(xcrun metal --version 2>/dev/null | head -1 | sed 's/^Apple metal version //'))"
  elif (( check )); then fail "no Metal compiler (shaders need it): xcodebuild -downloadComponent MetalToolchain"
  elif xcodebuild -downloadComponent MetalToolchain && xcrun metal --version > /dev/null 2>&1; then ok "Metal compiler (downloaded)"
  else fail "the Metal compiler did not install: xcodebuild -downloadComponent MetalToolchain"; fi
else
  fail "Xcode is not selected (${developer:-none}): install it from the App Store, then: sudo xcode-select -s /Applications/Xcode.app"
fi

section "Tools"
if ! command -v brew > /dev/null; then
  fail "Homebrew is not installed: install it from https://brew.sh (one command in Terminal), then check again"
elif (( check )); then
  if brew bundle check --file Brewfile --no-upgrade > /dev/null 2>&1; then ok "Homebrew tools (Brewfile)"
  else fail "Homebrew tools missing: brew bundle --file Brewfile"; fi
else
  step "Homebrew tools (Brewfile)" "brew bundle failed" brew bundle --file Brewfile --no-upgrade
fi
if (( !app_run )) && [[ -f mise.toml ]] && command -v mise > /dev/null; then
  if (( check )); then ok "mise: $(mise --version 2>/dev/null | awk '{print $1}') (mise.toml)"
  else mise trust --quiet 2>/dev/null; step "mise tools (mise.toml)" "mise install failed" mise install --quiet; fi
fi
if dotnet --list-sdks 2>/dev/null | grep -qE '^(1[0-9]|[2-9][0-9])\.'; then ok ".NET SDK $(dotnet --list-sdks | tail -1 | awk '{print $1}')"
else fail "no .NET 10 SDK (nx_extract needs it): brew install --cask dotnet-sdk"; fi

section "Python (.venv)"
if ! command -v uv > /dev/null; then
  fail "uv is not installed: brew install uv"
elif (( check )); then
  # the venv's copy of uv.lock is the lock it was last synced to: a newer DroidPlay that adds a package asks for setup
  if "$venv/bin/python3" -c 'import lz4, capstone, fontTools, nsz, zbic' 2> /dev/null && cmp -s uv.lock "$venv/nxplay-uv.lock"; then
    ok "$("$venv/bin/python3" --version) with nxnative's packages"
  else fail "the Python packages are missing or out of date: uv sync --locked"; fi
else
  if uv sync --locked --quiet && cp uv.lock "$venv/nxplay-uv.lock"; then ok "$("$venv/bin/python3" --version) with nxnative's packages (uv.lock)"
  else fail "uv sync failed"; fi
fi

section "nxnative"
if [[ -n "${NXNATIVE:-}" ]]; then repo="$NXNATIVE"
elif [[ -d nxnative || ! -d ../nxnative ]]; then repo="nxnative"
else repo="../nxnative"; fi
if [[ ! -f "$repo/scripts/build_ipa_from_nsp.py" ]]; then
  if (( check )); then fail "not cloned at $repo: git clone https://github.com/seedds/nxnative.git nxnative"
  else step "cloned into $repo" "git clone failed" git clone --quiet https://github.com/seedds/nxnative.git "$repo"; fi
fi
if [[ -f "$repo/scripts/build_ipa_from_nsp.py" ]]; then
  ok "$(cd "$repo" && pwd) ($(git -C "$repo" log -1 --format='%h, %cr'))"
  # nxnative builds shaders only with the Metal compiler it tested (dmsh_chain.lock), unless allowed
  tested="$(awk -F'\t' '$1 == "metal_macosx" { print $2 }' "$repo/dm/gfx/tools/dmsh_chain.lock" 2>/dev/null)"
  here="$(xcrun metal --version 2>/dev/null | head -1)"
  if [[ -n "$tested" && -n "$here" && "$here" != "$tested" ]]; then
    warn "Metal compiler ${here#Apple metal version } isn't the one nxnative tested (${tested#Apple metal version }): builds stop unless you allow it in DroidPlay's Settings (Allow a Metal compiler nxnative didn't test), or pass nxplay --allow-other-metal"
  elif [[ -n "$tested" && -n "$here" ]]; then
    ok "Metal compiler matches the one nxnative tested"
  fi
fi

# DroidPlay Core, for Install on Android and Build Game App: nxnative with its Android port, a checkout beside nxnative. A missing one is a ✗ like
# nxnative, so Install Missing clones it; a checkout set up before the rename keeps its nxnative-android folder
section "DroidPlay Core"
# a checkout cloned before a rename keeps its folder: droidnative (until 2026-11-09), nxnative-android before that
arepo=""
if [[ -n "${NXNATIVE_ANDROID:-}" ]]; then arepo="$NXNATIVE_ANDROID"
elif (( app_run )); then   # never beside this script: run from the app, that is inside the app bundle
  if [[ -d "$NXPLAY_HOME/droidnative" && ! -d "$NXPLAY_HOME/droidplay-core" ]]; then arepo="$NXPLAY_HOME/droidnative"; else arepo="$NXPLAY_HOME/droidplay-core"; fi
else
  for d in droidplay-core droidnative nxnative-android ../droidplay-core ../droidnative; do
    if [[ -z "$arepo" && -d "$d" ]]; then arepo="$d"; fi
  done
  [[ -n "$arepo" ]] || arepo="droidplay-core"
fi
if [[ ! -f "$arepo/scripts/build_android_from_nsp.py" ]]; then
  if (( check )); then fail "not cloned at $arepo (Install on Android needs it): git clone https://github.com/enjoyerofslop/droidplay-core.git '$arepo'"
  else step "cloned into $arepo" "git clone failed" git clone --quiet https://github.com/enjoyerofslop/droidplay-core.git "$arepo"; fi
fi
if [[ -f "$arepo/scripts/build_android_from_nsp.py" ]]; then ok "$(cd "$arepo" && pwd) ($(git -C "$arepo" log -1 --format='%h, %cr'))"; fi

# What DroidPlay Core's packer needs (build_android_from_nsp.py --check): a JDK 17 or newer (javac and keytool build and sign the app; the SDK's
# own tools need 17 to run), the SDK's command-line tools for sdkmanager, and the SDK packages below. The JDK and the command-line tools come
# from Homebrew (Brewfile.android, which Uninstall reads too); the packages go into ANDROID_HOME, else ~/Library/Android/sdk, Android
# Studio's place, where nxplay and DroidPlay look for adb. sdkmanager installs a package only once its license is accepted, and that is the
# player's to accept: in Terminal sdkmanager asks; DroidPlay asks in its own window, then runs this with NXPLAY_ANDROID_LICENSES=accept.
section "Android"
android_sdk="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}}"
android_packages=("platform-tools" "platforms;android-35" "build-tools;36.0.0" "ndk;28.2.13676358" "cmake;3.22.1")
android_has() {   # the file each package installs that the build runs or reads
  case "$1" in
    platform-tools) [[ -x "$android_sdk/platform-tools/adb" ]] ;;
    platforms\;*) [[ -f "$android_sdk/platforms/${1#*;}/android.jar" ]] ;;
    build-tools\;*) [[ -x "$android_sdk/build-tools/${1#*;}/aapt2" ]] ;;
    ndk\;*) [[ -f "$android_sdk/ndk/${1#*;}/build/cmake/android.toolchain.cmake" ]] ;;
    cmake\;*) [[ -x "$android_sdk/cmake/${1#*;}/bin/cmake" ]] ;;
    *) return 1 ;;
  esac
}
# the same places nxplay's android_tools looks, in its order: Homebrew's openjdk is keg-only and Android Studio's JBR isn't registered with java_home
find_jdk() {
  local j v
  for j in "${JAVA_HOME:-}" "$(/usr/libexec/java_home -v 17+ 2> /dev/null || true)" \
      /opt/homebrew/opt/openjdk{@21,@25,@17,}/libexec/openjdk.jdk/Contents/Home /usr/local/opt/openjdk{@21,@25,@17,}/libexec/openjdk.jdk/Contents/Home \
      "/Applications/Android Studio.app/Contents/jbr/Contents/Home"; do
    [[ -n "$j" && -x "$j/bin/javac" && -x "$j/bin/keytool" ]] || continue
    v="$(sed -n 's/^JAVA_VERSION="\([0-9]*\).*/\1/p' "$j/release" 2> /dev/null)"
    if (( ${v:-0} >= 17 )); then echo "$j"; return 0; fi
  done
  return 1
}
find_sdkmanager() {
  local s
  for s in "$android_sdk/cmdline-tools/latest/bin/sdkmanager" /opt/homebrew/bin/sdkmanager /usr/local/bin/sdkmanager; do
    if [[ -x "$s" ]]; then echo "$s"; return 0; fi
  done
  return 1
}
jdk="$(find_jdk || true)"
if [[ -z "$jdk" ]] && (( !check )) && command -v brew > /dev/null; then
  brew install --quiet openjdk@21 || true
  jdk="$(find_jdk || true)"
fi
if [[ -n "$jdk" ]]; then ok "JDK $(sed -n 's/^JAVA_VERSION="\(.*\)"/\1/p' "$jdk/release") ($jdk)"
else fail "no JDK 17 or newer (javac and keytool build and sign the Android app): brew install openjdk@21"; fi
sdkmanager="$(find_sdkmanager || true)"
if [[ -z "$sdkmanager" ]] && (( !check )) && command -v brew > /dev/null; then
  brew install --quiet --cask android-commandlinetools || true
  sdkmanager="$(find_sdkmanager || true)"
fi
if [[ -n "$sdkmanager" ]]; then ok "Android command-line tools ($sdkmanager)"
else fail "no Android command-line tools (sdkmanager installs the SDK): brew install --cask android-commandlinetools"; fi
android_missing() { local p; for p in "${android_packages[@]}"; do android_has "$p" || echo "$p"; done; }
missing_packages=()
while IFS= read -r p; do missing_packages+=("$p"); done < <(android_missing)
# The license these packages come under, accepted before in this SDK (Android Studio, or an earlier setup) when its file is there; DroidPlay
# then has nothing to ask. A license sdkmanager has updated since asks again, and the line that reports it names the license, so DroidPlay asks.
accepted=0
if [[ "${NXPLAY_ANDROID_LICENSES:-}" == accept ]]; then accepted=1; fi
if [[ -f "$android_sdk/licenses/android-sdk-license" ]]; then sdk_licensed=1; else sdk_licensed=0; fi
license_note="installing them accepts the Android SDK License: DroidPlay's Setup asks first, or run bin/setup in Terminal"
# yes answers each license sdkmanager shows for the packages it installs: only once the player accepted them in DroidPlay. Otherwise sdkmanager
# asks in Terminal, and without one finds no answer, so a package whose license isn't accepted yet stays out
sdk_install() {
  if (( accepted )); then
    { yes 2> /dev/null || true; } | JAVA_HOME="$jdk" "$sdkmanager" --sdk_root="$android_sdk" --install "$@"
  else JAVA_HOME="$jdk" "$sdkmanager" --sdk_root="$android_sdk" --install "$@"; fi
}
if (( ${#missing_packages[@]} == 0 )); then
  ok "Android SDK at $android_sdk: ${android_packages[*]}"
elif (( check )); then
  if (( sdk_licensed )); then fail "Android SDK packages missing at $android_sdk: ${missing_packages[*]}"
  else fail "Android SDK packages missing at $android_sdk: ${missing_packages[*]} ($license_note)"; fi
elif [[ -z "$jdk" || -z "$sdkmanager" ]]; then
  fail "Android SDK packages not installed at $android_sdk (${missing_packages[*]}): they need the JDK and the command-line tools above"
elif (( !accepted && !sdk_licensed )) && [[ ! -t 0 ]]; then
  fail "Android SDK packages missing at $android_sdk: ${missing_packages[*]} ($license_note)"
else
  mkdir -p "$android_sdk"
  sdk_install "${missing_packages[@]}" || true
  still=()
  while IFS= read -r p; do still+=("$p"); done < <(android_missing)
  if (( ${#still[@]} == 0 )); then ok "Android SDK at $android_sdk: ${android_packages[*]} (installed ${missing_packages[*]})"
  elif (( !accepted )) && [[ ! -t 0 ]]; then fail "Android SDK packages did not install at $android_sdk: ${still[*]} (if sdkmanager wanted a license accepted, $license_note)"
  else fail "Android SDK packages did not install at $android_sdk: ${still[*]}: $sdkmanager --sdk_root='$android_sdk' --install ${still[*]}"; fi
fi

section "Keys"
keys="${NX_KEYS:-$HOME/.switch/prod.keys}"
if [[ -f "$keys" ]]; then ok "prod.keys at $keys"
else warn "no prod.keys at $keys: dump them from your own Switch and put them there (or choose the file in DroidPlay's Settings)"; fi

# run from DroidPlay itself: there is nothing to build
if (( !app_run )); then
  section "DroidPlay"
  if (( check )); then
    if [[ -d "/Applications/DroidPlay.app" ]]; then ok "installed in /Applications"
    else warn "not installed: bin/install"; fi
  elif (( !app )); then
    warn "skipped (--no-app): bin/install builds and installs it"
  elif (( failures )); then
    warn "not built: fix the ✗ above first"
  else
    step "installed in /Applications" "bin/install failed" bin/install
  fi
fi

echo
if (( failures )); then
  if (( app_run )); then again="check again"; else again="run bin/setup again"; fi
  echo "${red}$failures problem$( (( failures == 1 )) || echo s) to fix${reset}; then $again."
  exit 1
fi
if (( check )); then echo "${green}All set.${reset}"
elif (( app_run )); then echo "${green}Done.${reset}"
else echo "${green}Done.${reset} Open DroidPlay, choose your games folder (one subfolder per game) and press Play."; fi
