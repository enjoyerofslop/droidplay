#!/bin/sh
# sudo's password prompt for DroidPlay's setup (SUDO_ASKPASS, sudo -A): Homebrew's .NET SDK installer and Xcode's
# first launch need an administrator, and the app has no terminal to ask in. Prints the password; cancel fails.
exec /usr/bin/osascript \
  -e 'set prompt to "DroidPlay is installing the tools Switch games need. Enter your password to allow it."' \
  -e 'text returned of (display dialog prompt with title "DroidPlay Setup" default answer "" with hidden answer with icon caution buttons {"Cancel", "OK"} default button "OK")'
